# Required locally and on Vercel Production. Leave it unset on Vercel Preview: the branch URL
# (VERCEL_BRANCH_URL, else VERCEL_URL) is used so email links return to that branch (docs/deployment.md).
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_...
SUPABASE_SECRET_KEY=                    # sb_secret_... server-only, never NEXT_PUBLIC_. Optional for the app until M9; integration tests need it locally

# Recurring job / cron route protection (only if a cron HTTP route is used)
CRON_SECRET=

# Optional custom SMTP (configured in Supabase dashboard for auth emails)
# Optional email provider for app emails
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# Optional exchange-rate provider (leave empty to use a keyless provider or disable conversion)
EXCHANGE_RATE_API_KEY=
