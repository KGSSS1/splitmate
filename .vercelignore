# Files Vercel must not deploy (Git integration and CLI; docs/deployment.md). Vercel builds from
# package.json, next.config.ts, src/ and public/; everything below is local-only.
# Every pattern starts with "/" so it only matches at the repository root:
# an unanchored "supabase" also matched src/lib/supabase/ and broke the build.
/.env*
!/.env.example
/.vercel/
/.claude/
/.next/
/node_modules/
/coverage/
/test-results/
/playwright-report/
/blob-report/
/supabase/
/tests/
/scripts/
# The Playwright configs import tests/e2e/support/, which isn't uploaded; the
# build's type check would fail on them (seen on the M9 staging build).
/playwright.config.ts
/playwright.staging.config.ts
